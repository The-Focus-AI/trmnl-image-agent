#!/bin/bash
# Main script to update TRMNL display
# Runs all steps: fetch → parse → prompt → generate → process
# Then commit/push to deploy via GitHub Pages

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"
START_TIME=$(date +%s)

echo "==========================================" >&2
echo "TRMNL Display Update - $(date)" >&2
echo "==========================================" >&2
echo "" >&2

# Step 1: Fetch all raw data in parallel
echo "Step 1/5: Fetching raw data (parallel)..." >&2
"$SCRIPT_DIR/fetch-all"
FETCH_TIME=$(date +%s)
echo "  Done in $((FETCH_TIME - START_TIME))s" >&2
echo "" >&2

# Step 2: Parse data with Grok
echo "Step 2/5: Parsing data with Grok..." >&2
"$SCRIPT_DIR/parse-data" > /dev/null
PARSE_TIME=$(date +%s)
echo "  Done in $((PARSE_TIME - FETCH_TIME))s" >&2
echo "" >&2

# Step 3: Build prompt from parsed data
echo "Step 3/5: Building image prompt..." >&2
"$SCRIPT_DIR/build-prompt" > /dev/null
PROMPT_FILE="/tmp/trmnl-prompt.txt"
BUILD_TIME=$(date +%s)
echo "  Prompt: $PROMPT_FILE" >&2
echo "  Done in $((BUILD_TIME - PARSE_TIME))s" >&2
echo "" >&2

# Step 4: Generate image with Grok Imagine
echo "Step 4/5: Generating image with Grok Imagine..." >&2
FULL_IMAGE=$("$SCRIPT_DIR/generate-image" "$PROMPT_FILE" | tail -1)
GEN_TIME=$(date +%s)
echo "  Output: $FULL_IMAGE" >&2
echo "  Done in $((GEN_TIME - BUILD_TIME))s" >&2
echo "" >&2

# Step 5: Process image for TRMNL (also copies to latest.png)
echo "Step 5/5: Processing image for e-ink..." >&2
FINAL_IMAGE=$("$SCRIPT_DIR/process-image" "$FULL_IMAGE" | tail -1)
PROC_TIME=$(date +%s)
echo "  Output: $FINAL_IMAGE" >&2
echo "  Done in $((PROC_TIME - GEN_TIME))s" >&2
echo "" >&2

# Summary
TOTAL_TIME=$((PROC_TIME - START_TIME))
LATEST_PNG="$REPO_DIR/output/latest.png"

echo "==========================================" >&2
echo "Complete! Total time: ${TOTAL_TIME}s" >&2
echo "" >&2
echo "Timing breakdown:" >&2
echo "  Fetch:    $((FETCH_TIME - START_TIME))s" >&2
echo "  Parse:    $((PARSE_TIME - FETCH_TIME))s" >&2
echo "  Prompt:   $((BUILD_TIME - PARSE_TIME))s" >&2
echo "  Generate: $((GEN_TIME - BUILD_TIME))s" >&2
echo "  Process:  $((PROC_TIME - GEN_TIME))s" >&2
echo "" >&2
echo "Final image: $FINAL_IMAGE" >&2
echo "Latest:      $LATEST_PNG" >&2
echo "" >&2
echo "Commit and push to deploy via GitHub Pages" >&2
echo "==========================================" >&2

# process-image must have written the Pages entrypoint
if [ ! -f "$LATEST_PNG" ]; then
  echo "Error: $LATEST_PNG missing after process-image" >&2
  exit 1
fi
if [ ! -f "$FINAL_IMAGE" ]; then
  echo "Error: final image missing: $FINAL_IMAGE" >&2
  exit 1
fi

# Keep local OpenClaw media in sync with the same 1-bit image Pages serves
OPENCLAW_MEDIA_DIR="$HOME/.openclaw/media/trmnl"
mkdir -p "$OPENCLAW_MEDIA_DIR"
cp -f "$LATEST_PNG" "$OPENCLAW_MEDIA_DIR/latest.png"

PUBLISH_ON_SUCCESS="${PUBLISH_ON_SUCCESS:-1}"
if [ "$PUBLISH_ON_SUCCESS" = "1" ]; then
  if ! git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: not a git repository; cannot publish output/latest.png to GitHub" >&2
    exit 1
  fi

  # Always force-stage the Pages image + this run's dated assets first
  git -C "$REPO_DIR" add -f -- output/latest.png
  # FINAL_IMAGE may be relative (output/...) or absolute; normalize for git add
  case "$FINAL_IMAGE" in
    /*) FINAL_REL="${FINAL_IMAGE#"$REPO_DIR"/}" ;;
    *)  FINAL_REL="$FINAL_IMAGE" ;;
  esac
  if [ -f "$REPO_DIR/$FINAL_REL" ]; then
    git -C "$REPO_DIR" add -f -- "$FINAL_REL"
    # Also stage the full-color source if present next to the processed PNG
    FULL_CANDIDATE="${FINAL_REL%.png}-full.jpg"
    FULL_CANDIDATE2="${FINAL_REL%.png}-full.png"
    [ -f "$REPO_DIR/$FULL_CANDIDATE" ] && git -C "$REPO_DIR" add -f -- "$FULL_CANDIDATE"
    [ -f "$REPO_DIR/$FULL_CANDIDATE2" ] && git -C "$REPO_DIR" add -f -- "$FULL_CANDIDATE2"
  fi

  # Stage other project paths that may change with a pipeline run
  for path in run.sh setup.sh bin scripts package.json package-lock.json trmnl_prompt_builder.py tests README.md CLAUDE.md MEMORY.md prompts .github; do
    if [ -e "$REPO_DIR/$path" ]; then
      git -C "$REPO_DIR" add -- "$path"
    fi
  done

  if ! git -C "$REPO_DIR" diff --cached --quiet --ignore-submodules --; then
    # Require latest.png to be part of the commit when it actually changed
    if ! git -C "$REPO_DIR" diff --cached --quiet -- output/latest.png; then
      echo "Staging output/latest.png for GitHub Pages" >&2
    fi
    git -C "$REPO_DIR" commit -m "Update TRMNL image

Co-Authored-By: Grok <noreply@x.ai>"
  else
    echo "No new git changes to commit" >&2
  fi

  # Push if we are ahead of upstream (covers this commit and any prior unpushed ones)
  UPSTREAM="$(git -C "$REPO_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [ -z "$UPSTREAM" ]; then
    echo "Pushing main (no upstream set)..." >&2
    git -C "$REPO_DIR" push -u origin HEAD
  else
    AHEAD="$(git -C "$REPO_DIR" rev-list --count "${UPSTREAM}..HEAD" 2>/dev/null || echo 0)"
    if [ "${AHEAD:-0}" -gt 0 ]; then
      echo "Pushing $AHEAD commit(s) to $UPSTREAM..." >&2
      git -C "$REPO_DIR" push
    else
      echo "Remote already has latest commit" >&2
    fi
  fi

  # Verify latest.png is present in HEAD (what Pages will deploy from main)
  if ! git -C "$REPO_DIR" cat-file -e "HEAD:output/latest.png" 2>/dev/null; then
    echo "Error: output/latest.png is not in HEAD after publish" >&2
    exit 1
  fi
  echo "Published output/latest.png to GitHub (Pages workflow deploys on push to main)" >&2
  echo "Pages URL: https://the-focus-ai.github.io/trmnl-image-agent/latest.png" >&2
else
  echo "Skipping GitHub publish (PUBLISH_ON_SUCCESS=$PUBLISH_ON_SUCCESS)" >&2
fi

# Output the final image path for scripting (only stdout line)
echo "$FINAL_IMAGE"
