# Required: Parallel Web Systems API key (PDF & web /v1/extract, /v1/search, /v1/decisions, and /v1beta/chat/completions)
PARALLEL_API_KEY=

# Recommended in Preview/Production: shared bearer secret protecting Vercel Cron GET /api/cron
CRON_SECRET=

# Optional persistent cloud store for /admin high-level run history (provision either Upstash Redis OR Vercel Blob)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
